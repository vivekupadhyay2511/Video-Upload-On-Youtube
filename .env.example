YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
# This redirect URI is used for token refresh during uploads (must match your Google Cloud Console setting)
YOUTUBE_REDIRECT_URI=https://developers.google.com/oauthplayground
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token
# App URL used to build the re-auth callback (the /api/auth/callback route)
NEXT_PUBLIC_APP_URL=http://localhost:3000
